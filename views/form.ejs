<!--form.ejs-->
<html>

<head>
    <title>New Post</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <h1>Add Your Post</h1>
    <form method="POST" action="/new" class="post-list">
    <div class="post">
        <input id="form-user" class="user" name = "user" placeholder="Your Name">
        <input id="form-text" class="body" name = "text" placeholder="Your Message">
    </div>
    <button type="submit" class="btn">Post Message</button>
    </form>
</body>

</html>