<!--index.ejs-->

<html>

<head>
    <title>
        <%- title %>
    </title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <h1>Message Board</h1>
    <div class="post-list">
        <% messages.forEach((message)=> { %>
            <%- include('messages/message',{text:message.text,user:message.user,added:message.added}); %>
        <% }); %>
    </div>
    <a id="create-post" href="new" class="btn">Create Post</a>
</body>

</html>